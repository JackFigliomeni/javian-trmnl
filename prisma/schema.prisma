generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Role values: "STAFF" | "CLIENT"
// OrderStatus values: "PENDING" | "CONFIRMED" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"

model User {
  id         String   @id @default(cuid())
  username   String   @unique
  password   String
  role       String   @default("CLIENT")
  clientName String?
  createdAt  DateTime @default(now())
  orders     Order[]
}

model ContactInquiry {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  company   String?
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Order {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  providerName     String
  flightNumber     String
  departureTime    DateTime
  passengerCount   Int
  deliveryLocation String
  foodDetails      String
  specialNotes     String?
  attachmentUrl    String?
  attachmentName   String?
  status           String   @default("PENDING")
  orderPrice       Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
